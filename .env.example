# Base de datos — PostgreSQL instalado localmente (fuera de Docker)
# El contenedor web lo alcanza via host.docker.internal
POSTGRES_DB=plataforma_gestion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_en_produccion
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5434
# prefer = usa TLS si el servidor lo ofrece, no falla si no.
# Azure Database for PostgreSQL EXIGE require; en Azure lo inyecta Terraform.
POSTGRES_SSLMODE=prefer

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Validación estricta de formatos SAP (codigo=V-00869252/D, PEP=L-00869252/A, grafo=2000269630).
# False: los formatos no SAP solo generan avisos. True: se rechazan al guardar (admin, API y carga masiva).
SAP_VALIDACION_ESTRICTA=False

# ---------------------------------------------------------------------------
# SSO con Microsoft Entra ID (opcional)
# ---------------------------------------------------------------------------
# El login local con usuario/contraseña funciona SIEMPRE, con o sin esto.
# Activar el SSO solo añade el botón "Iniciar sesión con Microsoft".
#
# En Azure estos valores los inyecta Terraform automáticamente. En local solo
# hacen falta para probar el flujo de SSO contra el tenant real, y exigen añadir
# http://localhost:8000/oidc/callback/ como redirect URI en el App Registration.
OIDC_HABILITADO=False
# OIDC_TENANT_ID=fdb323c6-1c3c-47a4-9144-2cabbc82699c
# OIDC_RP_CLIENT_ID=            # terraform output entra_client_id
# OIDC_RP_CLIENT_SECRET=        # terraform output -raw entra_client_secret
# True  = a quien entre por SSO y no exista en Django se le crea la cuenta.
# False = solo entran usuarios ya existentes.
# OIDC_CREAR_USUARIOS=True

# Equivalencia de dominio entre Entra y la identidad de negocio.
# El tenant no tiene verificado inetum.com, asi que los UPN son
# nombre@inetumoffshore.onmicrosoft.com mientras que aqui (y en Recurso.email)
# la persona es nombre@inetum.com. Sin esta traduccion el SSO no reconoceria
# ninguna cuenta existente y crearia duplicados.
# OIDC_DOMINIO_ALIAS=inetumoffshore.onmicrosoft.com=inetum.com

# Identidades de Entra que apuntan a una cuenta concreta de Django, para UPN
# que no derivan de ningun email de negocio. La cuenta enlazada asi conserva su
# email y su nombre: el alias dice "esta identidad ES esta cuenta".
# OIDC_USUARIO_ALIAS=admin@inetumoffshore.onmicrosoft.com=inetum_admin

# ---------------------------------------------------------------------------
# Producción / Azure (solo con DJANGO_SETTINGS_MODULE=config.settings.production)
# ---------------------------------------------------------------------------
# Estos valores los pone Terraform en los secretos de la Container App; no hace
# falta gestionarlos a mano. Se dejan documentados para despliegues manuales.
# DJANGO_ALLOWED_HOSTS=ca-platgestion-prod.eastus2.azurecontainerapps.io
# CORS_ALLOWED_ORIGINS=https://ca-platgestion-prod.eastus2.azurecontainerapps.io
# CSRF_TRUSTED_ORIGINS=https://ca-platgestion-prod.eastus2.azurecontainerapps.io
# GUNICORN_WORKERS=2
